{
  "name": "anthropic.nonstream.native-context-compaction-trigger-unknown-to-ir",
  "description": "A compact_20260112 edit with an uninterpretable trigger is dropped with an unmapped-value loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {"protocol": "anthropic"},
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "messages": [{"role": "user", "content": "Question."}],
    "context_management": {
      "edits": [
        {
          "type": "compact_20260112",
          "trigger": {"type": "tokens", "value": 50000}
        }
      ]
    }
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [{"role": "user", "content": [{"type": "text", "text": "Question."}]}],
    "params": {"max_tokens": 16000}
  },
  "expected_losses": [
    {
      "path": "context_management.edits[0].trigger",
      "field": "trigger",
      "reason": "unmapped-value"
    }
  ],
  "tags": ["request", "context-management", "compaction-trigger", "loss"]
}
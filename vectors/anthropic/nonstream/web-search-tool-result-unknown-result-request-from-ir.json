{
  "name": "anthropic.nonstream.web-search-tool-result-unknown-result-request-from-ir",
  "description": "The opaque web_search_tool_result content text renders back as the same future search-result objects without interpretation (N-AN-23, INV-1).",
  "spec_version": "0.3.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "specVersion": "0.3.0",
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "go"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "s1",
            "name": "web_search",
            "input": "{\"query\":\"q\"}"
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "s1",
            "content": "[{\"page_age\":9007199254740993,\"title\":\"A\",\"type\":\"future_search_result\",\"url\":\"https://example.com/a\"}]"
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 16000
    }
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "go"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "s1",
            "name": "web_search",
            "input": {
              "query": "q"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "s1",
            "content": [
              {
                "type": "future_search_result",
                "url": "https://example.com/a",
                "title": "A",
                "page_age": 9007199254740993
              }
            ]
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "request",
    "web-search",
    "native",
    "inv-1"
  ]
}

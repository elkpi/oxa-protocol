{
  "name": "anthropic.nonstream.server-tool-use-history-request-from-ir",
  "description": "ServerToolUseBlock and WebSearchToolResultBlock encode back to Anthropic history blocks (N-AN-23).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {
    "protocol": "anthropic"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "search"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "srvtoolu_1",
            "name": "web_search",
            "input": "{\"query\":\"news\"}",
            "caller": "{\"type\":\"direct\"}"
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "srvtoolu_1",
            "content": "[{\"encrypted_content\":\"CIPHER\",\"title\":\"A\",\"type\":\"web_search_result\",\"url\":\"https://example.com/a\"}]",
            "caller": "{\"type\":\"direct\"}"
          }
        ]
      }
    ],
    "params": {
      "max_tokens": 1024
    }
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "search"
          }
        ]
      },
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "srvtoolu_1",
            "name": "web_search",
            "input": {
              "query": "news"
            },
            "caller": {
              "type": "direct"
            }
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "srvtoolu_1",
            "content": [
              {
                "encrypted_content": "CIPHER",
                "title": "A",
                "type": "web_search_result",
                "url": "https://example.com/a"
              }
            ],
            "caller": {
              "type": "direct"
            }
          }
        ]
      }
    ]
  },
  "expected_losses": [],
  "tags": [
    "request",
    "web-search-history",
    "n-an-23"
  ]
}

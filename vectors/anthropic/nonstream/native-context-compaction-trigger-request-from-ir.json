{
  "name": "anthropic.nonstream.native-context-compaction-trigger-request-from-ir",
  "description": "An IR request with a compact_20260112 native edit encodes back to Anthropic context_management.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "from-ir",
  "source": {"protocol": "anthropic"},
  "target": {"protocol": "anthropic"},
  "input": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [{"role": "user", "content": [{"type": "text", "text": "Question."}]}],
    "params": {"max_tokens": 16000},
    "native": [
      {
        "source": "anthropic",
        "kind": "context_management",
        "value": "{\"edits\":[{\"pause_after_compaction\":true,\"trigger\":{\"type\":\"input_tokens\",\"value\":50000},\"type\":\"compact_20260112\"}]}",
        "omission": {"field": "context_management", "reason": "unsupported-semantic"}
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_tokens": 16000,
    "messages": [{"role": "user", "content": "Question."}],
    "context_management": {
      "edits": [
        {
          "type": "compact_20260112",
          "trigger": {"type": "input_tokens", "value": 50000},
          "pause_after_compaction": true
        }
      ]
    }
  },
  "expected_losses": [],
  "tags": ["request", "context-management", "compaction-trigger"]
}
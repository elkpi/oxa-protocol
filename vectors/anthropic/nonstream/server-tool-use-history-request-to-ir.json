{
  "name": "anthropic.nonstream.server-tool-use-history-request-to-ir",
  "description": "Anthropic server_tool_use and web_search_tool_result history map to their IR blocks with canonical JSON text (N-AN-23).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {"protocol": "anthropic"},
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {"role": "user", "content": "search"},
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "srvtoolu_1",
            "name": "web_search",
            "input": {"query": "news"},
            "caller": {"type": "direct"}
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "srvtoolu_1",
            "content": [
              {
                "type": "web_search_result",
                "url": "https://example.com/a",
                "title": "A",
                "encrypted_content": "CIPHER"
              }
            ],
            "caller": {"type": "direct"}
          }
        ]
      }
    ]
  },
  "expected_ir": {
    "specVersion": "0.2.0",
    "model": "claude-opus-5-5",
    "messages": [
      {"role": "user", "content": [{"type": "text", "text": "search"}]},
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "srvtoolu_1",
            "name": "web_search",
            "input": "{\"query\":\"news\"}",
            "caller": "{\"type\":\"direct\"}"
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "srvtoolu_1",
            "content": "[{\"encrypted_content\":\"CIPHER\",\"title\":\"A\",\"type\":\"web_search_result\",\"url\":\"https://example.com/a\"}]",
            "caller": "{\"type\":\"direct\"}"
          }
        ]
      }
    ],
    "params": {"max_tokens": 1024}
  },
  "expected_losses": [],
  "tags": ["request", "web-search-history", "n-an-23"]
}
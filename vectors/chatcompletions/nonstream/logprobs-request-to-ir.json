{
  "name": "chatcompletions.nonstream.logprobs-request-to-ir",
  "description": "Chat Completions logprobs and top_logprobs are preserved on the IR request.",
  "spec_version": "0.1.0",
  "mode": "nonstream",
  "conversion": "to-ir",
  "source": {
    "protocol": "chatcompletions"
  },
  "input": {
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": "Hello"
      }
    ],
    "logprobs": true,
    "top_logprobs": 5
  },
  "expected_ir": {
    "specVersion": "0.1.0",
    "model": "gpt-4o-mini",
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello"
          }
        ]
      }
    ],
    "params": {
      "logprobs": true,
      "top_logprobs": 5
    }
  },
  "expected_losses": [],
  "tags": [
    "request",
    "logprobs"
  ]
}

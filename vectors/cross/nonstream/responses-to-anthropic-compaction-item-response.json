{
  "name": "cross.nonstream.responses-to-anthropic-compaction-item-response",
  "description": "A Responses compaction output item is omitted on Anthropic with one loss, keeping the text content (N-R-22).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "responses"},
  "target": {"protocol": "anthropic"},
  "input": {
    "id": "resp_cmp_ant_cross",
    "object": "response",
    "status": "completed",
    "model": "gpt-5.4",
    "output": [
      {"type": "compaction", "id": "cmp_1", "encrypted_content": "cipher"},
      {"type": "message", "id": "msg_1", "status": "completed", "role": "assistant", "content": [{"type": "output_text", "text": "hi", "annotations": []}]}
    ],
    "usage": {"input_tokens": 5, "output_tokens": 10, "total_tokens": 15}
  },
  "expected_output": {
    "id": "resp_cmp_ant_cross",
    "type": "message",
    "role": "assistant",
    "model": "gpt-5.4",
    "content": [{"type": "text", "text": "hi"}],
    "stop_reason": "end_turn",
    "usage": {"input_tokens": 5, "output_tokens": 10}
  },
  "expected_losses": [
    {
      "path": "content[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "Responses compaction item cannot be represented on the target face"
    }
  ],
  "tags": ["cross", "response", "compaction", "loss", "n-r-22"]
}
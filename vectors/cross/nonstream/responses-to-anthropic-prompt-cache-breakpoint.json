{
  "name": "cross.nonstream.responses-to-anthropic-prompt-cache-breakpoint",
  "description": "Cross encoding from Responses to Anthropic: an explicit breakpoint becomes cache_control without ttl; mode is a loss.",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {
    "protocol": "responses"
  },
  "target": {
    "protocol": "anthropic"
  },
  "input": {
    "model": "claude-3-5-sonnet",
    "max_output_tokens": 1024,
    "input": [
      {
        "type": "message",
        "role": "user",
        "content": [
          {
            "type": "input_text",
            "text": "Hello",
            "prompt_cache_breakpoint": {
              "mode": "explicit"
            }
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-3-5-sonnet",
    "max_tokens": 1024,
    "messages": [
      {
        "role": "user",
        "content": [
          {
            "type": "text",
            "text": "Hello",
            "cache_control": {
              "type": "ephemeral"
            }
          }
        ]
      }
    ]
  },
  "expected_losses": [
    {
      "path": "messages[0].content[0].native[0]",
      "field": "mode",
      "reason": "unmapped-field",
      "detail": "prompt_cache_breakpoint.mode is not represented by cache_control"
    }
  ],
  "tags": [
    "cross",
    "request",
    "responses",
    "anthropic",
    "prompt_cache_breakpoint"
  ]
}

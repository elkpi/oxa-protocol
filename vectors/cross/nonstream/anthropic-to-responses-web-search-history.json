{
  "name": "cross.nonstream.anthropic-to-responses-web-search-history",
  "description": "Anthropic server_tool_use and web_search_tool_result are omitted on Responses with one loss each and are not rewritten as web_search_call (N-AN-23).",
  "spec_version": "0.2.0",
  "mode": "nonstream",
  "conversion": "protocol-to-protocol",
  "source": {"protocol": "anthropic"},
  "target": {"protocol": "responses"},
  "input": {
    "model": "claude-opus-5-5",
    "max_tokens": 1024,
    "messages": [
      {"role": "user", "content": "search"},
      {
        "role": "assistant",
        "content": [
          {
            "type": "server_tool_use",
            "id": "srvtoolu_1",
            "name": "web_search",
            "input": {"query": "news"}
          }
        ]
      },
      {
        "role": "user",
        "content": [
          {
            "type": "web_search_tool_result",
            "tool_use_id": "srvtoolu_1",
            "content": [
              {
                "type": "web_search_result",
                "url": "https://example.com/a",
                "title": "A",
                "encrypted_content": "CIPHER"
              }
            ]
          }
        ]
      }
    ]
  },
  "expected_output": {
    "model": "claude-opus-5-5",
    "max_output_tokens": 1024,
    "input": [
      {"role": "user", "content": "search"},
      {"role": "user", "content": []}
    ]
  },
  "expected_losses": [
    {
      "path": "messages[1].content[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "Anthropic web_search history cannot be represented on the target face"
    },
    {
      "path": "messages[2].content[0]",
      "field": "type",
      "reason": "unsupported-semantic",
      "detail": "Anthropic web_search history cannot be represented on the target face"
    }
  ],
  "tags": ["cross", "request", "web-search-history", "loss", "n-an-23"]
}